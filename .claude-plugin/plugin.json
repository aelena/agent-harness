{
  "name": "agent-harness",
  "description": "Research, plan, implement and review skills, read-only subagents, and a guard that blocks secret leaks and destructive commands.",
  "version": "1.0.0",
  "license": "MIT",
  "keywords": [
    "harness",
    "skills",
    "hooks",
    "guardrails",
    "rpi",
    "openspec"
  ],
  "skills": "./.agents/skills",
  "agents": [
    "./.agents/agents/explorer.md",
    "./.agents/agents/reviewer.md"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/.agents/harness/hooks/guard.mjs",
              "--agent",
              "claude"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
